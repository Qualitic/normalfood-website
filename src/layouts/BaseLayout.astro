---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrderLink from '../components/OrderLink.astro';
import { brand } from '../data/site';
import type { DietId } from '../data/diets';

interface Props { title: string; description: string; diet?: DietId; orderLabel?: string; noindex?: boolean; }
const { title, description, diet, orderLabel = 'Wybierz dietę', noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://normalfood.pl');
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'FoodEstablishment', name: brand.name,
  url: site.href, logo: new URL('/logo.png', site).href,
  telephone: brand.phone, email: brand.email,
  address: { '@type': 'PostalAddress', streetAddress: brand.street, postalCode: brand.postalCode, addressLocality: brand.city, addressCountry: 'PL' },
  areaServed: { '@type': 'Country', name: 'Polska' },
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-normalfood.jpg', site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Domowy schabowy z ziemniakami i mizerią — wizualizacja dania" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <div class="mobile-order"><OrderLink diet={diet} class="mobile-order-link">{orderLabel}</OrderLink></div>
  </body>
</html>
